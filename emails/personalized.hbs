<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <title>{{subject}}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
      body,table,td,a { -ms-text-size-adjust:100%;
      -webkit-text-size-adjust:100%; text-size-adjust:100%; } img {
      -ms-interpolation-mode:bicubic; border:0; outline:0; text-decoration:none;
      display:block; } table { border-collapse:collapse !important; } body {
      margin:0; padding:0; width:100% !important; background:#0f172a; } .wrap {
      max-width:640px; margin:0 auto; padding:24px; } /* KHÔNG bo góc khung
      ngoài cùng */ .card { background:#0b1220; border:1px solid #1e293b;
      border-radius:0; } .p-24 { padding:24px; } .text { color:#e2e8f0;
      font-family: system-ui, -apple-system, Segoe UI, Roboto, 'Helvetica Neue',
      Arial; line-height:1.6; } .center { text-align:center; } .heading {
      color:#ffffff; font-weight:800; font-size:26px; margin:0;
      letter-spacing:0.2px; } .sub { color:#94a3b8; font-size:14px; margin:8px 0
      0 0; } .h2 { color:#fff; font-weight:800; font-size:18px; margin:18px 0
      8px; } .lead { color:#e2e8f0; font-size:16px; margin:8px 0 0; }
      .price-accent { color:#22d3ee; font-weight:900; } .btn {
      display:inline-block; padding:12px 20px; border-radius:10px;
      background:#6366f1; color:#fff !important; font-weight:700;
      text-decoration:none; }
      .mt-8{margin-top:8px}.mt-12{margin-top:12px}.mt-16{margin-top:16px}.mt-20{margin-top:20px}.mt-24{margin-top:24px}
      .row { width:100%; } .col { vertical-align:top; padding:8px; } .col-6 {
      width:50%; } /* Bullet bằng table 2 cột + spacer row để giãn dòng ổn định
      */ .li { width:100%; } .li-ico { width:22px; vertical-align:top; } .li-dot
      { width:18px; height:18px; border-radius:999px; background:#0097b2;
      color:#fff; font-weight:700; font-size:10px; line-height:18px;
      text-align:center; display:inline-block; } .li-txt { color:#e2e8f0;
      font-size:16px; vertical-align:top; padding-left:10px; } .li-gap {
      height:10px; line-height:10px; font-size:10px; } .note { color:#94a3b8;
      font-size:12px; } .footer { color:#94a3b8; font-size:12px; } .muted-link {
      color:#94a3b8; text-decoration:underline; } @media (max-width:480px){
      .col-6 { display:block; width:100% !important; } .heading {
      font-size:22px; } } .preheader { display:none!important;
      visibility:hidden; opacity:0; color:transparent; height:0; width:0;
      overflow:hidden; mso-hide:all; }
    </style>
  </head>
  <body class="text">
    {{#if preheader}}<div class="preheader">{{preheader}}</div>{{/if}}

    <div class="wrap">
      <table role="presentation" class="card" width="100%">
        <tr>
          <td class="p-24">

            <!-- Header: logo + chữ TJZenn (Roboto) -->
            <table role="presentation" width="100%">
              <tr>
                <td style="text-align:center;">
                  <table role="presentation" style="margin:0 auto;">
                    <tr>
                      <td style="vertical-align:middle;">
                        <a
                          href="https://tjzenn.com"
                          style="text-decoration:none;"
                        >
                          <img
                            src="https://tjzenn.com/images/logo.png"
                            alt="TJZenn"
                            width="100"
                            height="95"
                          />
                        </a>
                      </td>
                      <td style="vertical-align:middle; padding-left:10px;">
                        <span
                          style="font-family:'Roboto','Helvetica Neue','Arial',sans-serif;font-size:25px;font-weight:900;letter-spacing:.5px;color:#fff;text-shadow:0 2px 0 #0b1220,0 0 8px rgba(34,211,238,.35);"
                        >
                          TJZenn
                        </span>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
            </table>

            <!-- Chào tên -->
            <section class="mt-16">
              <p class="lead">
                Xin chào
                {{#if name}}{{name}}{{else}}bạn{{/if}},
              </p>
              <p class="lead">
                Em là Nhật Thanh từ
                <strong>TJZenn</strong>. Em có xem qua website
                {{#if brand}}<strong>{{brand}}</strong>{{/if}}
                {{#if siteUrl}}(<a
                    href="{{siteUrl}}"
                    style="color:#93c5fd;text-decoration:underline;"
                  >{{siteUrl}}</a>){{/if}}
                và muốn gửi một vài nhận xét nhanh – kèm hướng cải thiện cụ thể
                để chốt khách tốt hơn.
              </p>
            </section>

            <!-- Bối cảnh hiện nay -->
            <section class="mt-20">
              <p class="h2">Bối cảnh hiện nay: website cần gì để hiệu quả?</p>

              <table
                role="presentation"
                class="li"
                cellpadding="0"
                cellspacing="0"
              ><tr>
                  <td class="li-ico"><span class="li-dot">✓</span></td>
                  <td class="li-txt">Tải nhanh & điểm Core Web Vitals tốt (điện
                    thoại là chính).</td>
                </tr><tr><td colspan="2" class="li-gap">&nbsp;</td></tr></table>

              <table
                role="presentation"
                class="li"
                cellpadding="0"
                cellspacing="0"
              ><tr>
                  <td class="li-ico"><span class="li-dot">✓</span></td>
                  <td class="li-txt">Chuẩn SEO (schema, meta, sitemap) để lên
                    top tự nhiên.</td>
                </tr><tr><td colspan="2" class="li-gap">&nbsp;</td></tr></table>

              <table
                role="presentation"
                class="li"
                cellpadding="0"
                cellspacing="0"
              ><tr>
                  <td class="li-ico"><span class="li-dot">✓</span></td>
                  <td class="li-txt">Nội dung rõ ràng, CTA nổi bật, form gọn –
                    giảm ma sát chuyển đổi.</td>
                </tr><tr><td colspan="2" class="li-gap">&nbsp;</td></tr></table>

              <table
                role="presentation"
                class="li"
                cellpadding="0"
                cellspacing="0"
              ><tr>
                  <td class="li-ico"><span class="li-dot">✓</span></td>
                  <td class="li-txt">Trust signals (logo KH, đánh giá, bảo
                    hành/đổi trả, hotline rõ).</td>
                </tr><tr><td colspan="2" class="li-gap">&nbsp;</td></tr></table>

              <table
                role="presentation"
                class="li"
                cellpadding="0"
                cellspacing="0"
              ><tr>
                  <td class="li-ico"><span class="li-dot">✓</span></td>
                  <td class="li-txt">Theo dõi đo lường (GA4, Events, Pixel) để
                    tối ưu liên tục.</td>
                </tr><tr><td colspan="2" class="li-gap">&nbsp;</td></tr></table>

              <table
                role="presentation"
                class="li"
                cellpadding="0"
                cellspacing="0"
              ><tr>
                  <td class="li-ico"><span class="li-dot">✓</span></td>
                  <td class="li-txt">Bảo mật & SSL, bản quyền hình ảnh, chống
                    spam form.</td>
                </tr><tr><td colspan="2" class="li-gap">&nbsp;</td></tr></table>
            </section>

            <!-- Nhược điểm web hiện tại -->
            <section class="mt-20">
              <p class="h2">Một vài nhược điểm em thấy ở website hiện tại{{#if
                  brand
                }} của {{brand}}{{/if}}:</p>

              {{#if weaknesses}}
                {{#each weaknesses}}
                  <table
                    role="presentation"
                    class="li"
                    cellpadding="0"
                    cellspacing="0"
                  ><tr>
                      <td class="li-ico"><span class="li-dot">•</span></td>
                      <td class="li-txt">{{this}}</td>
                    </tr><tr><td
                        colspan="2"
                        class="li-gap"
                      >&nbsp;</td></tr></table>
                {{/each}}
              {{else}}
                <table
                  role="presentation"
                  class="li"
                  cellpadding="0"
                  cellspacing="0"
                ><tr>
                    <td class="li-ico"><span class="li-dot">•</span></td>
                    <td class="li-txt">Tốc độ trang chưa tối ưu (ảnh lớn, chưa
                      dùng lazy-load/caching).</td>
                  </tr><tr><td
                      colspan="2"
                      class="li-gap"
                    >&nbsp;</td></tr></table>

                <table
                  role="presentation"
                  class="li"
                  cellpadding="0"
                  cellspacing="0"
                ><tr>
                    <td class="li-ico"><span class="li-dot">•</span></td>
                    <td class="li-txt">CTA và form liên hệ chưa nổi bật, nhiều
                      bước.</td>
                  </tr><tr><td
                      colspan="2"
                      class="li-gap"
                    >&nbsp;</td></tr></table>

                <table
                  role="presentation"
                  class="li"
                  cellpadding="0"
                  cellspacing="0"
                ><tr>
                    <td class="li-ico"><span class="li-dot">•</span></td>
                    <td class="li-txt">Thiếu schema/metadata nên SEO chưa phát
                      huy.</td>
                  </tr><tr><td
                      colspan="2"
                      class="li-gap"
                    >&nbsp;</td></tr></table>

                <table
                  role="presentation"
                  class="li"
                  cellpadding="0"
                  cellspacing="0"
                ><tr>
                    <td class="li-ico"><span class="li-dot">•</span></td>
                    <td class="li-txt">Ít trust signals (đánh giá, dự án tiêu
                      biểu, bảo hành).</td>
                  </tr><tr><td
                      colspan="2"
                      class="li-gap"
                    >&nbsp;</td></tr></table>
              {{/if}}
            </section>

            <!-- Giải pháp cải thiện (NHẬN TỪ BÊN NGOÀI) -->
            <section class="mt-20">
              <p class="h2">TJZenn có thể cải thiện cho
                {{#if brand}}{{brand}}{{else}}bên mình{{/if}}:</p>

              {{#if improvements}}
                {{#each improvements}}
                  <table
                    role="presentation"
                    class="li"
                    cellpadding="0"
                    cellspacing="0"
                  ><tr>
                      <td class="li-ico"><span class="li-dot">✓</span></td>
                      <td class="li-txt">{{this}}</td>
                    </tr><tr><td
                        colspan="2"
                        class="li-gap"
                      >&nbsp;</td></tr></table>
                {{/each}}
              {{else}}
                <!-- Danh sách mặc định nếu không truyền improvements -->
                <table
                  role="presentation"
                  class="li"
                  cellpadding="0"
                  cellspacing="0"
                ><tr>
                    <td class="li-ico"><span class="li-dot">✓</span></td>
                    <td class="li-txt">Tối ưu hiệu năng: nén ảnh,
                      preload-critical, CDN, mã hoá route – mục tiêu
                      <strong>Lighthouse ≥ 90</strong>.</td>
                  </tr><tr><td
                      colspan="2"
                      class="li-gap"
                    >&nbsp;</td></tr></table>

                <table
                  role="presentation"
                  class="li"
                  cellpadding="0"
                  cellspacing="0"
                ><tr>
                    <td class="li-ico"><span class="li-dot">✓</span></td>
                    <td class="li-txt">Chuẩn SEO: schema (Organization, Product,
                      FAQ…), sitemap, robots, nội dung & cấu trúc heading.</td>
                  </tr><tr><td
                      colspan="2"
                      class="li-gap"
                    >&nbsp;</td></tr></table>

                <table
                  role="presentation"
                  class="li"
                  cellpadding="0"
                  cellspacing="0"
                ><tr>
                    <td class="li-ico"><span class="li-dot">✓</span></td>
                    <td class="li-txt">Thiết kế lại flow chuyển đổi: hero + lợi
                      ích rõ, CTA nổi, form 1–2 trường, chat/phone 1 chạm.</td>
                  </tr><tr><td
                      colspan="2"
                      class="li-gap"
                    >&nbsp;</td></tr></table>

                <table
                  role="presentation"
                  class="li"
                  cellpadding="0"
                  cellspacing="0"
                ><tr>
                    <td class="li-ico"><span class="li-dot">✓</span></td>
                    <td class="li-txt">Thêm trust signals: đánh giá KH, logo đối
                      tác, chính sách bảo hành/đổi trả, ảnh dự án thật.</td>
                  </tr><tr><td
                      colspan="2"
                      class="li-gap"
                    >&nbsp;</td></tr></table>

                <table
                  role="presentation"
                  class="li"
                  cellpadding="0"
                  cellspacing="0"
                ><tr>
                    <td class="li-ico"><span class="li-dot">✓</span></td>
                    <td class="li-txt">Gắn GA4/Pixel + sự kiện: đo lead theo
                      nguồn, heatmap (tùy chọn) để A/B test.</td>
                  </tr><tr><td
                      colspan="2"
                      class="li-gap"
                    >&nbsp;</td></tr></table>

                <table
                  role="presentation"
                  class="li"
                  cellpadding="0"
                  cellspacing="0"
                ><tr>
                    <td class="li-ico"><span class="li-dot">✓</span></td>
                    <td class="li-txt">Bảo mật & vận hành: SSL, chặn spam, sao
                      lưu định kỳ, bảo hành trọn đời.</td>
                  </tr><tr><td
                      colspan="2"
                      class="li-gap"
                    >&nbsp;</td></tr></table>
              {{/if}}

              <div class="mt-16">
                <a class="btn" href="https://tjzenn.com/contact">Nhận tư vấn
                  miễn phí</a>
              </div>
            </section>

            <!-- Hero + 2 cột (giống template trước) -->
            <section class="center mt-16">
              <h1 class="heading" style="text-transform:uppercase;">
                Thiết kế
                <span style="color:#bd5fcc;">website</span>
                chuyên nghiệp
              </h1>
              <p class="heading" style="margin-top:6px;">Chỉ từ
                <span style="font-size:40px;" class="price-accent">1,5 triệu</span></p>
            </section>

            <table role="presentation" class="row mt-16">
              <tr>
                <!-- LEFT -->
                <td class="col col-6">
                  <table
                    role="presentation"
                    class="li"
                    cellpadding="0"
                    cellspacing="0"
                  ><tr>
                      <td class="li-ico"><span class="li-dot">✓</span></td>
                      <td class="li-txt">Tặng domain miễn phí</td>
                    </tr><tr><td
                        colspan="2"
                        class="li-gap"
                      >&nbsp;</td></tr></table>

                  <table
                    role="presentation"
                    class="li"
                    cellpadding="0"
                    cellspacing="0"
                  ><tr>
                      <td class="li-ico"><span class="li-dot">✓</span></td>
                      <td class="li-txt">Không chi phí phát sinh</td>
                    </tr><tr><td
                        colspan="2"
                        class="li-gap"
                      >&nbsp;</td></tr></table>

                  <table
                    role="presentation"
                    class="li"
                    cellpadding="0"
                    cellspacing="0"
                  ><tr>
                      <td class="li-ico"><span class="li-dot">✓</span></td>
                      <td class="li-txt">Giao diện theo yêu cầu</td>
                    </tr><tr><td
                        colspan="2"
                        class="li-gap"
                      >&nbsp;</td></tr></table>

                  <table
                    role="presentation"
                    class="li"
                    cellpadding="0"
                    cellspacing="0"
                  ><tr>
                      <td class="li-ico"><span class="li-dot">✓</span></td>
                      <td class="li-txt">Bảo hành trọn đời</td>
                    </tr><tr><td
                        colspan="2"
                        class="li-gap"
                      >&nbsp;</td></tr></table>

                  <div class="mt-16">
                    <a class="btn" href="https://tjzenn.com/contact">Liên hệ
                      ngay</a>
                  </div>
                </td>

                <!-- RIGHT -->
                <td class="col col-6" style="text-align:center;">
                  <img
                    src="https://tjzenn.com/images/email-mkt/email_mkt_website.png"
                    alt="TJZenn Mascot"
                    width="260"
                    style="margin:0 auto;"
                  />
                </td>
              </tr>
            </table>

            <!-- Footer -->
            <table role="presentation" width="100%" class="mt-24">
              <tr><td style="height:1px; background:#1e293b;"></td></tr>
              <tr>
                <td class="center mt-16 footer">
                  <p style="margin:0;">©
                    {{year}}
                    TJZenn. All rights reserved.</p>
                  <p style="margin:6px 0 0 0;">
                    <a
                      class="muted-link"
                      href="https://tjzenn.com"
                    >tjzenn.com</a>
                    •
                    <a
                      class="muted-link"
                      href="mailto:contact.tjzenn@gmail.com"
                    >contact.tjzenn@gmail.com</a>
                    •
                    <span>0812.303.471</span>
                  </p>
                </td>
              </tr>
            </table>

          </td>
        </tr>
      </table>
    </div>
  </body>
</html>